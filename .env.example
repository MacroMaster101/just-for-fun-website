# Copy to .env and fill in real values. .env is gitignored — never commit it.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# ─────────────────────────────────────────────────────────────
# Database (Supabase Postgres)
# Both URLs use Supabase's IPv4 pooler (Connect → Connection string).
# ─────────────────────────────────────────────────────────────
# Runtime queries: Transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# Schema changes only (`npx prisma db push --url "$DIRECT_URL"`):
# Session pooler, port 5432. Local only — not needed on Vercel.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Supabase Auth & Storage
# ─────────────────────────────────────────────────────────────
# Public — exposed to the browser (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECTREF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only — bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────────────────────────────────────────────────────────
# Root administrator (server-only; seeded into the admin list on first
# login). Must be a verified email. Other admins are managed in /admin.
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="your-admin-email@gmail.com"

# ─────────────────────────────────────────────────────────────
# YouTube Data API v3
# Restrict the key to "YouTube Data API v3" in Google Cloud Console.
# ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY="your-youtube-data-api-key"
YOUTUBE_CHANNEL_ID="UCcCp0B0bypJE4EJjwq8u2lQ"
YOUTUBE_CHANNEL_HANDLE="@JustForFun-BoYs"

# Protects the daily cron at /api/youtube/refresh, which must send it as
# `Authorization: Bearer <CRON_SECRET>` (Vercel Cron does this for you).
# Generate one with: openssl rand -hex 32
CRON_SECRET="your-32-byte-hex-secret"

# ─────────────────────────────────────────────────────────────
# Email (Resend) — contact form alerts and admin replies
# resend.com → API Keys → "Sending access" key for the j4fn.site domain.
# Without RESEND_API_KEY, messages are still saved but no email is sent.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_your-resend-api-key"
# Sender address on your verified Resend domain.
EMAIL_FROM="Just For Fun <noreply@j4fn.site>"
# Inbox that receives contact alerts and users' replies. Defaults to ADMIN_EMAIL.
CONTACT_INBOX_EMAIL="your-inbox@gmail.com"

# ─────────────────────────────────────────────────────────────
# RAWG video games database — admin game search (rawg.io/apidocs)
# ─────────────────────────────────────────────────────────────
RAWG_API_KEY="your-rawg-api-key"

# ─────────────────────────────────────────────────────────────
# Discord webhook — Challenge Slot "send to Discord" (server-only)
# Channel ⚙️ → Integrations → Webhooks → New Webhook → Copy URL
# ─────────────────────────────────────────────────────────────
DISCORD_CHALLENGE_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/YYYY"
